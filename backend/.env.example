# Which provider the Model Adapter loads. Must match a key in src/models/modelAdapter.js
ATLAS_MODEL_PROVIDER=qwen

OLLAMA_MODEL=qwen3:8b

# Used by src/models/modelRouter.js to pick a model per intent.
# General model handles everything except coding intent; coder model is
# pulled in specifically for writing/editing/analyzing/debugging code.
OLLAMA_MODEL_GENERAL=qwen3:4b
OLLAMA_MODEL_CODER=qwen2.5-coder:7b

# Optional Ollama keep_alive overrides (e.g. "30m", "-1" for always-on).
# General model defaults to 30m in modelRouter.js so it stays warm across a
# session. Coder model has no override by default - it uses Ollama's normal
# 5m keep_alive, since combined VRAM for both models loaded at once (~2.5GB
# + ~4.7GB in Q4) leaves little headroom for context on an 8GB 3060 Ti.
OLLAMA_KEEPALIVE_GENERAL=30m
OLLAMA_KEEPALIVE_CODER=
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=1800

TTS_ENABLED=true
TTS_PROVIDER=kokoro
TTS_VOICE=af_bella
TTS_SPEED=1.0
TTS_KOKORO_URL=http://localhost:7860

# Kokoro Process Management
KOKORO_URL=http://127.0.0.1:7860
KOKORO_ENDPOINT=/gradio_api/call/generate_speech
KOKORO_ROOT=C:\Users\Lani\Desktop\kokoro_NVIDIA_GPU_ONLY
KOKORO_AUTOSTART=true
KOKORO_STARTUP_TIMEOUT=15000

# Gemini Models
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq models
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Serper - used for web search. Sign up at https://serper.dev to get a key.
SERPER_API_KEY=your_key_here

# Supabase - all of Atlas's memory (working memory, profile, project/knowledge/
# procedural memory, dev state, reflections, world model) lives here now.
# Get these from Supabase > Project Settings > API.
# Use the service_role key (not anon) - Atlas runs as a trusted backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
